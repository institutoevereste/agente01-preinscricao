rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pré-inscrição do curso Agente 01: a página só cria registros. Ninguém lê, altera ou apaga pelo site;
    // a lista é vista no console do Firebase. O id do documento é o WhatsApp, então cada número entra uma vez.
    // Duas páginas gravam aqui: a do Academy (nome, WhatsApp, e-mail e curso) e a antiga (nome, idade, área e WhatsApp).
    // Por isso só nome, WhatsApp e consentimento são obrigatórios; o resto é conferido quando vem.
    match /preinscricoes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'idade', 'trabalho', 'whatsapp', 'email', 'curso', 'consentimento'])
        && request.resource.data.keys().hasAll(['nome', 'whatsapp', 'consentimento'])
        && request.resource.data.nome is string && request.resource.data.nome.size() >= 3 && request.resource.data.nome.size() <= 120
        && request.resource.data.whatsapp is string && request.resource.data.whatsapp.matches('^[1-9][0-9]{9,10}$')
        && request.resource.data.whatsapp == id
        && request.resource.data.consentimento == true
        && (!('idade' in request.resource.data) || (request.resource.data.idade is int && request.resource.data.idade >= 14 && request.resource.data.idade <= 100))
        && (!('trabalho' in request.resource.data) || (request.resource.data.trabalho is string && request.resource.data.trabalho.size() >= 2 && request.resource.data.trabalho.size() <= 60))
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 120 && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')))
        && (!('curso' in request.resource.data) || (request.resource.data.curso is string && request.resource.data.curso.size() <= 40));
    }
  }
}
